// Reference declarative pipeline (read it, be able to explain every block).
pipeline {
    agent any

    tools {
        jdk 'jdk21'        // names configured in "Manage Jenkins > Tools"
        maven 'maven3'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY = 'registry.example.com'
        IMAGE    = "${REGISTRY}/riskcube:${env.GIT_COMMIT}"   // immutable tag = commit
    }

    stages {
        stage('Build & unit tests') {
            steps {
                sh 'mvn -B verify'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'       // test results visible in Jenkins UI
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Docker image') {
            when { branch 'main' }
            steps {
                sh 'docker build -t $IMAGE .'
                withCredentials([usernamePassword(credentialsId: 'registry-creds',
                                                  usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    sh 'echo "$REG_PASS" | docker login $REGISTRY -u "$REG_USER" --password-stdin'
                    sh 'docker push $IMAGE'
                }
            }
        }

        stage('Deploy to staging') {
            when { branch 'main' }
            steps {
                sh 'kubectl -n riskcube-staging set image deployment/riskcube app=$IMAGE'
                sh 'kubectl -n riskcube-staging rollout status deployment/riskcube --timeout=180s'
            }
        }

        stage('Deploy to production') {
            when { branch 'main' }
            steps {
                input message: 'Deploy this build to PRODUCTION?', ok: 'Deploy'
                sh 'kubectl -n riskcube-prod set image deployment/riskcube app=$IMAGE'
                sh 'kubectl -n riskcube-prod rollout status deployment/riskcube --timeout=300s'
            }
        }
    }

    post {
        failure {
            echo 'Build failed: notify the team (Slack / Teams / email plugin)'
        }
    }
}
